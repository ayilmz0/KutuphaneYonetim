@model List<KutuphaneYonetim.Models.Kitap>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    var rol = HttpContextAccessor.HttpContext.Session.GetString("Rol");
}

@if (Model != null && Model.Any())
{
    @foreach (var kitap in Model)
    {
        <tr id="row-@kitap.KitapId">
            <td class="font-medium text-main">@kitap.KitapAd</td>
            <td class="text-muted">@kitap.Yazar</td>
            <td>
                <span class="category-badge">@(kitap.Kategori != null ? kitap.Kategori.KategoriAd : "Kategorisiz")</span>
            </td>
            <td>
                <div class="action-buttons">
                    @if (rol == "Personel")
                    {
                        <button type="button" class="action-btn btn-delete delete-btn" data-id="@kitap.KitapId">
                            Sil
                        </button>
                        <a asp-action="Update" asp-route-id="@kitap.KitapId" class="action-btn btn-edit">
                            Güncelle
                        </a>
                    }
                    <a asp-controller="Odunc" asp-action="OduncAl" asp-route-KitapId="@kitap.KitapId" class="action-btn btn-borrow">
                        Ödünç Al
                    </a>
                </div>
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="4" class="text-center text-muted py-4">
            Aramanızla eşleşen herhangi bir kitap bulunamadı.
        </td>
    </tr>
}