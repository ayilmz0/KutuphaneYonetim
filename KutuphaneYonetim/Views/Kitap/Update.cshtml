@model KutuphaneYonetim.Models.Kitap
@{
    ViewData["Title"] = "Kitap Güncelle";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<div class="page-container">
    <div class="header-section">
        <h1 class="page-title">Kitap Bilgilerini Güncelle</h1>
        <p class="page-subtitle">Sistemdeki mevcut kitabın detaylarını düzenleyin.</p>
    </div>

    <div id="sonuc" class="mb-4"></div>

    <div class="form-card">
        <form id="guncelleForm" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="KitapId" />

            <div class="form-grid">
                <div class="form-group full-width">
                    <label class="modern-label">Kitap Adı</label>
                    <input asp-for="KitapAd" class="modern-input" placeholder="Kitap adını giriniz" />
                    <span asp-validation-for="KitapAd" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="modern-label">Yazar</label>
                    <input asp-for="Yazar" class="modern-input" placeholder="Yazar adını giriniz" />
                    <span asp-validation-for="Yazar" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="modern-label">Yayın Evi</label>
                    <input asp-for="YayinEvi" class="modern-input" placeholder="Yayın evini giriniz" />
                    <span asp-validation-for="YayinEvi" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="modern-label">Sayfa Sayısı</label>
                    <input asp-for="SayfaSayisi" type="number" class="modern-input" placeholder="0" />
                    <span asp-validation-for="SayfaSayisi" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="modern-label">ISBN Numarası</label>
                    <input asp-for="ISBN" class="modern-input" placeholder="ISBN giriniz" />
                    <span asp-validation-for="ISBN" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="modern-label">Stok Adedi</label>
                    <input asp-for="Stok" type="number" class="modern-input" placeholder="0" />
                    <span asp-validation-for="Stok" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="modern-label">Kategori</label>
                    <div class="select-wrapper">
                        <select asp-for="KategoriId" asp-items="ViewBag.Kategori" class="modern-input">
                            <option value="0">Kategori Seçiniz</option>
                        </select>
                    </div>
                    <span asp-validation-for="KategoriId" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="modern-label">Durum</label>
                    <div class="select-wrapper">
                        <select asp-for="Durum" class="modern-input">
                            <option value="true">Aktif (Kullanımda)</option>
                            <option value="false">Pasif (Kullanım Dışı)</option>
                        </select>
                    </div>
                    <span asp-validation-for="Durum" class="validation-error"></span>
                </div>
            </div>

            <div class="form-actions">
                <a href="/Kitap/Index" class="btn-secondary">İptal Et</a>
                <button type="submit" class="btn-primary" id="submitBtn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    Değişiklikleri Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

<style>

    :root {
        --bg-body: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --input-bg: #f8fafc;

        --primary: #2563eb;
        --primary-hover: #1d4ed8;
        --danger: #ef4444;
        --success: #10b981;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--bg-body);
        color: var(--text-main);
    }

    .page-container {
        max-width: 800px;
        margin: 40px auto;
        padding: 0 20px;
        animation: fadeUp 0.6s ease-out forwards;
    }

    .header-section {
        text-align: center;
        margin-bottom: 30px;
    }

    .page-title {
        font-size: 2.2rem;
        font-weight: 700;
        margin: 0 0 5px 0;
        color: var(--text-main);
        letter-spacing: -0.5px;
    }

    .page-subtitle {
        color: var(--text-muted);
        font-size: 1.05rem;
        margin: 0;
    }

    .form-card {
        background-color: var(--card-bg);
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 10px 40px -10px rgba(0,0,0,0.06);
        border: 1px solid var(--border-color);
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px 24px;
    }

    .full-width {
        grid-column: span 2;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .modern-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .modern-input {
        width: 100%;
        padding: 14px 16px;
        border-radius: 12px;
        border: 1.5px solid var(--border-color);
        background-color: var(--input-bg);
        font-family: inherit;
        font-size: 0.95rem;
        color: var(--text-main);
        outline: none;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .modern-input:focus {
        border-color: var(--primary);
        background-color: #fff;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
    }

    .modern-input::placeholder {
        color: #cbd5e1;
    }

    .select-wrapper {
        position: relative;
    }

    select.modern-input {
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 16px center;
        background-size: 16px;
        padding-right: 40px;
    }

    .validation-error {
        color: var(--danger);
        font-size: 0.8rem;
        font-weight: 500;
        margin-top: 2px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 16px;
        margin-top: 30px;
        padding-top: 24px;
        border-top: 1px solid var(--border-color);
    }

    .btn-secondary {
        padding: 14px 24px;
        border-radius: 12px;
        font-weight: 600;
        color: var(--text-muted);
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-secondary:hover {
        background-color: #f1f5f9;
        color: var(--text-main);
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background-color: var(--primary);
        color: white;
        border: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        box-shadow: 0 8px 20px -6px rgba(37, 99, 235, 0.5);
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: var(--primary-hover);
        transform: translateY(-2px);
        box-shadow: 0 12px 25px -6px rgba(37, 99, 235, 0.6);
    }

    .btn-primary:disabled {
        opacity: 0.7;
        cursor: not-allowed;
        transform: none;
    }

    .alert-box {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        border-radius: 12px;
        font-size: 0.95rem;
        animation: slideDownFade 0.4s ease-out;
    }
    .alert-success { background-color: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; }
    .alert-danger { background-color: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes slideDownFade {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 640px) {
        .form-grid { grid-template-columns: 1fr; }
        .full-width { grid-column: span 1; }
        .form-card { padding: 24px; }
        .form-actions { flex-direction: column-reverse; }
        .btn-primary, .btn-secondary { width: 100%; text-align: center; justify-content: center; }
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $("#guncelleForm").submit(function (e) {
        e.preventDefault();

        const submitBtn = $("#submitBtn");
        const orjinalMetin = submitBtn.html();

        submitBtn.prop("disabled", true).html(`
            <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
            Güncelleniyor...
        `);

        if (!$('#spin-style').length) {
            $('head').append('<style id="spin-style">@@keyframes spin { 100% { transform: rotate(360deg); } } .animate-spin { animation: spin 1s linear infinite; }</style>');
        }

        var id = $("#KitapId").val();

        $.ajax({
            type: "PUT",
            url: "/api/Kitap/" + id,
            data: $(this).serialize(),
            success: function (res) {
                if (res.success) {
                    $("#sonuc").html(`
                        <div class="alert-box alert-success">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            <div><strong>Başarılı!</strong> ${res.message} Listeye yönlendiriliyorsunuz...</div>
                        </div>
                    `);

                    setTimeout(function () {
                        window.location.href = "/Kitap/Index";
                    }, 1500);
                } else {
                    $("#sonuc").html(`
                        <div class="alert-box alert-danger">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                            <div><strong>Hata!</strong> ${res.message}</div>
                        </div>
                    `);
                    submitBtn.prop("disabled", false).html(orjinalMetin);
                }
            },
            error: function () {
                $("#sonuc").html(`
                    <div class="alert-box alert-danger">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                        <div><strong>Sistem Hatası!</strong> Sunucu ile iletişim kurulamadı. Lütfen tekrar deneyin.</div>
                    </div>
                `);
                submitBtn.prop("disabled", false).html(orjinalMetin);
            }
        });
    });
</script>