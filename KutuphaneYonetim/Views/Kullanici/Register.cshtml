@model KutuphaneYonetim.Models.Kullanici

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kullanıcı Girişi & Kayıt</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #333;
        }

        .alert-container {
            width: 100%;
            max-width: 850px;
            margin-bottom: 20px;
        }

        .alert-box {
            background-color: #fee2e2;
            border-left: 5px solid #ef4444;
            color: #b91c1c;
            padding: 12px 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            font-size: 14px;
        }

        #chk {
            display: none;
        }

        .wrapper {
            position: relative;
            width: 850px;
            height: 550px;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 24px 50px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            display: flex;
        }

        .form-box {
            position: absolute;
            top: 0;
            width: 50%;
            height: 100%;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

            .form-box.login-form {
                left: 0;
            }

            .form-box.register-form {
                right: 0;
            }

            .form-box h2 {
                font-size: 32px;
                color: #0f172a;
                margin-bottom: 25px;
                font-weight: 700;
            }

        form {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        input:not([type="radio"]) {
            width: 100%;
            background: #f1f5f9;
            padding: 14px 15px;
            margin: 8px 0;
            border: 2px solid transparent;
            outline: none;
            border-radius: 10px;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            transition: all 0.3s ease;
        }

            input:not([type="radio"]):focus {
                border-color: #3b82f6;
                background: #ffffff;
                box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
            }

        .role-selector {
            display: flex;
            width: 100%;
            background: #f1f5f9;
            padding: 6px;
            border-radius: 10px;
            margin: 8px 0;
            justify-content: space-between;
        }

            .role-selector input[type="radio"] {
                display: none;
            }

            .role-selector label {
                flex: 1;
                text-align: center;
                padding: 10px 0;
                font-size: 14px;
                color: #64748b;
                cursor: pointer;
                border-radius: 8px;
                transition: all 0.3s ease;
                font-weight: 500;
            }

            .role-selector input[type="radio"]:checked + label {
                background: #3b82f6;
                color: #ffffff;
                box-shadow: 0 4px 10px rgba(59, 130, 246, 0.3);
                font-weight: 600;
            }

        button {
            width: 100%;
            height: 48px;
            margin-top: 15px;
            color: #fff;
            background: #2563eb;
            font-size: 16px;
            font-weight: 600;
            font-family: 'Poppins', sans-serif;
            outline: none;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);
        }

            button:hover {
                background: #1d4ed8;
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(37, 99, 235, 0.4);
            }

        .overlay-box {
            position: absolute;
            top: 0;
            left: 50%;
            width: 50%;
            height: 100%;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            transition: left 0.7s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            box-shadow: -10px 0 20px rgba(0,0,0,0.1);
        }

        #chk:checked ~ .wrapper .overlay-box {
            left: 0;
            box-shadow: 10px 0 20px rgba(0,0,0,0.1);
        }

        .overlay-content {
            position: absolute;
            width: 100%;
            padding: 40px;
            text-align: center;
            color: #ffffff;
            transition: transform 0.7s ease, opacity 0.7s ease;
        }

            .overlay-content h1 {
                font-size: 35px;
                font-weight: 700;
                margin-bottom: 15px;
                line-height: 1.2;
            }

            .overlay-content p {
                font-size: 15px;
                margin-bottom: 30px;
                line-height: 1.6;
                opacity: 0.9;
            }

            .overlay-content label.ghost-btn {
                border: 2px solid #ffffff;
                background: transparent;
                color: #ffffff;
                padding: 12px 35px;
                border-radius: 30px;
                cursor: pointer;
                font-size: 16px;
                font-weight: 600;
                display: inline-block;
                transition: background 0.3s, color 0.3s;
            }

                .overlay-content label.ghost-btn:hover {
                    background: #ffffff;
                    color: #1e3a8a;
                }

        .register-text {
            opacity: 1;
            transform: translateX(0);
            pointer-events: auto;
        }

        .login-text {
            opacity: 0;
            transform: translateX(-100%);
            pointer-events: none;
        }

        #chk:checked ~ .wrapper .overlay-box .register-text {
            opacity: 0;
            transform: translateX(100%);
            pointer-events: none;
        }

        #chk:checked ~ .wrapper .overlay-box .login-text {
            opacity: 1;
            transform: translateX(0);
            pointer-events: auto;
        }
    </style>
</head>
<body>

    @if (TempData["Hata"] != null)
    {
        <div class="alert-container">
            <div class="alert-box" role="alert">
                <strong>Hata!</strong> @TempData["Hata"]
            </div>
        </div>
    }

    <input type="checkbox" id="chk" aria-hidden="true">

    <div class="wrapper">

        <div class="form-box login-form">
            <h2>Giriş Yap</h2>
            <form asp-action="Login" method="post">
                <input type="email" name="Email" placeholder="Email" required>
                <input type="password" name="Sifre" placeholder="Şifre" required>
                <button type="submit">Giriş Yap</button>
            </form>
        </div>

        <div class="form-box register-form">
            <h2>Üye Ol</h2>
            <form asp-action="Register" method="post">
                <input type="text" asp-for="Ad" placeholder="Ad" required>
                <input type="text" asp-for="Soyad" placeholder="Soyad" required>
                <input type="email" asp-for="Email" placeholder="Email" required>
                <input type="password" asp-for="Sifre" placeholder="Şifre" required>

                <button type="submit">Kayıt Ol</button>
            </form>
        </div>

        <div class="overlay-box">

            <div class="overlay-content register-text">
                <h1>Hoşgeldin<br>Kitap Kurdu!</h1>
                <p>Henüz kütüphanemize üye değil misin? Kitapların büyülü dünyasına katılmak için hemen profilini oluştur.</p>
                <label for="chk" class="ghost-btn">Hemen Üye Ol</label>
            </div>

            <div class="overlay-content login-text">
                <h1>Hoşgeldin<br>Kitap Kurdu!</h1>
                <p>Zaten bir hesabın var mı? O halde giriş yap ve kaldığın yerden okumaya devam et.</p>
                <label for="chk" class="ghost-btn">Giriş Yap</label>
            </div>

        </div>
    </div>

</body>
</html>