@model KutuphaneYonetim.Models.DashboardViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
}

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    var rol = HttpContextAccessor.HttpContext.Session.GetString("Rol");
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

@if (rol == "Personel")
{
    <div class="dashboard-container">
        <div class="dashboard-header">
            <h1 class="dashboard-title">Personel İstatistikleri</h1>
            <p class="dashboard-subtitle">Sistemin genel durumuna hızlı bir bakış</p>
        </div>

        <div class="dashboard-grid">
            <div class="card" style="animation-delay: 0.1s;">
                <div class="card-icon icon-blue">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M4 21v-2a4 4 0 0 1 3-3.87"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <div class="card-content">
                    <h3>Aktif Kullanıcı Sayısı</h3>
                    <p class="card-value">@Model.AktifKullaniciSayisi</p>
                </div>
            </div>

            <div class="card" style="animation-delay: 0.2s;">
                <div class="card-icon icon-green">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                    </svg>
                </div>
                <div class="card-content">
                    <h3>Toplam Kitap Sayısı</h3>
                    <p class="card-value">@Model.ToplamKitapSayisi.ToString("N0")</p>
                </div>
            </div>

            <div class="card" style="animation-delay: 0.3s;">
                <div class="card-icon icon-yellow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="2" x2="12" y2="22"></line>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                    </svg>
                </div>
                <div class="card-content">
                    <h3>Toplam Kategori Sayısı</h3>
                    <p class="card-value">@Model.ToplamKategoriSayisi</p>
                </div>
            </div>
        </div>
    </div>
}

@if (rol == "Üye")
{
    <div class="dashboard-container">
        <div class="dashboard-header">
            <h1 class="dashboard-title">Kitap İstatistikleri</h1>
            <p class="dashboard-subtitle">Okuma serüveninizin güncel özeti</p>
        </div>

        <div class="dashboard-grid">
            <div class="card" style="animation-delay: 0.1s;">
                <div class="card-icon icon-blue">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                </div>
                <div class="card-content">
                    <h3>Okunan Kitap Sayısı</h3>
                    <p class="card-value">@Model.OkunanKitapSayisi</p>
                </div>
            </div>

            <div class="card" style="animation-delay: 0.2s;">
                <div class="card-icon icon-green">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                </div>
                <div class="card-content">
                    <h3>Okunan Toplam Sayfa</h3>
                    <p class="card-value">@Model.ToplamSayfa.ToString("N0")</p>
                </div>
            </div>

            <div class="card" style="animation-delay: 0.3s;">
                <div class="card-icon icon-yellow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                </div>
                <div class="card-content">
                    <h3>Son Okunan Kitap</h3>
                    <p class="card-value small-text">@Model.SonOkunanKitapAdi</p>
                </div>
            </div>
        </div>
    </div>
}

<style>
    :root {

        --background-color: #f8fafc;
        --card-background: #ffffff;
        --text-primary: #0f172a;
        --text-secondary: #64748b;

        --blue-light: #eff6ff;
        --blue-main: #3b82f6;

        --green-light: #ecfdf5;
        --green-main: #10b981;

        --yellow-light: #fffbeb;
        --yellow-main: #f59e0b;
    }

    body {
        background-color: var(--background-color);
        font-family: 'Poppins', sans-serif;
        color: var(--text-primary);
        margin: 0;
    }

    .dashboard-container {
        max-width: 1100px;
        margin: 50px auto;
        padding: 0 20px;
    }

    .dashboard-header {
        text-align: center;
        margin-bottom: 50px;
        animation: fadeDown 0.8s ease-out forwards;
    }

    .dashboard-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0 0 10px 0;
        color: var(--text-primary);
        letter-spacing: -0.5px;
    }

    .dashboard-subtitle {
        font-size: 1.1rem;
        color: var(--text-secondary);
        margin: 0;
        font-weight: 400;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
    }

    .card {
        background-color: var(--card-background);
        border-radius: 24px;
        padding: 35px 30px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.8);
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);

        opacity: 0;
        transform: translateY(30px);
        animation: fadeUp 0.8s ease-out forwards;
    }

    .card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.12);
    }

    .card-icon {
        width: 70px;
        height: 70px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: transform 0.3s ease;
    }

    .card:hover .card-icon {
        transform: scale(1.1) rotate(5deg);
    }

    .icon-blue { background-color: var(--blue-light); color: var(--blue-main); }
    .icon-green { background-color: var(--green-light); color: var(--green-main); }
    .icon-yellow { background-color: var(--yellow-light); color: var(--yellow-main); }

    .card-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .card-content h3 {
        font-size: 1rem;
        font-weight: 500;
        color: var(--text-secondary);
        margin: 0 0 8px 0;
    }

    .card-value {
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.1;
        margin: 0;
    }

    .card-value.small-text {
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    @@keyframes fadeDown {
        0% { opacity: 0; transform: translateY(-20px); }
        100% { opacity: 1; transform: translateY(0); }
    }

    @@keyframes fadeUp {
        0% { opacity: 0; transform: translateY(30px); }
        100% { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 768px) {
        .dashboard-title { font-size: 2rem; }
        .card { padding: 25px 20px; flex-direction: column; text-align: center; }
        .card-value { font-size: 2rem; }
        .card-icon { width: 60px; height: 60px; margin-bottom: 10px; }
    }
</style>