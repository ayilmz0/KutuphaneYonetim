@model KutuphaneYonetim.Models.Profil

@{
    ViewData["Title"] = "Profilim";
}

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    var rol = HttpContextAccessor.HttpContext.Session.GetString("Rol");
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<div class="page-container">
    <div class="header-section">
        <h1 class="page-title">Profilim</h1>
        <p class="page-subtitle">Sistemdeki kişisel bilgilerinizi ve hesap detaylarınızı görüntüleyin.</p>
    </div>

    <div class="profile-card">
        <div class="profile-banner"></div>

        <div class="profile-avatar-wrapper">
            <img class="profile-avatar" src="https://st5.depositphotos.com/83039852/70317/v/600/depositphotos_703179392-stock-illustration-user-account-icon-default-avatar.jpg" alt="Profil Resmi">
        </div>

        <div class="profile-header">
            <h2>@Model.AdSoyad</h2>
            <span class="role-badge">@Model.Rol</span>
        </div>

        <hr class="divider" />

        <div class="profile-details">
            <div class="detail-item">
                <div class="detail-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                </div>
                <div class="detail-content">
                    <span class="detail-label">E-Posta Adresi</span>
                    <span class="detail-value">@Model.Email</span>
                </div>
            </div>

            <div class="detail-item">
                <div class="detail-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </div>
                <div class="detail-content">
                    <span class="detail-label">Hesap Durumu</span>
                    <span class="detail-value">
                        @if (Model.Durum)
                        {
                            <span class="status-badge status-active"><span class="dot"></span> Aktif</span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive"><span class="dot"></span> Kullanılmıyor</span>
                        }
                    </span>
                </div>
            </div>

            @if (rol == "Üye")
            {
                <div class="detail-item">
                    <div class="detail-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    </div>
                    <div class="detail-content">
                        <span class="detail-label">Kayıt Tarihi</span>
                        <span class="detail-value">@(Model.KayitTarihi != DateTime.MinValue ? Model.KayitTarihi?.ToShortDateString() : "Bilinmiyor")</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>

    :root {
        --bg-body: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;

        --primary: #6366f1;
        --primary-hover: #4f46e5;

        --success: #10b981;
        --danger: #ef4444;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--bg-body);
        color: var(--text-main);
    }

    .page-container {
        max-width: 600px; 
        margin: 40px auto;
        padding: 0 20px;
        animation: fadeUp 0.6s ease-out forwards;
    }

    .header-section {
        text-align: center;
        margin-bottom: 30px;
    }

    .page-title {
        font-size: 2.2rem;
        font-weight: 700;
        margin: 0 0 5px 0;
        color: var(--text-main);
        letter-spacing: -0.5px;
    }

    .page-subtitle {
        color: var(--text-muted);
        font-size: 1.05rem;
        margin: 0;
    }

    .profile-card {
        background-color: var(--card-bg);
        border-radius: 24px;
        box-shadow: 0 10px 40px -10px rgba(0,0,0,0.08);
        border: 1px solid var(--border-color);
        overflow: hidden;
        position: relative;
    }

    .profile-banner {
        height: 140px;
        background: linear-gradient(135deg, var(--primary), #8b5cf6);
        position: relative;
    }

    .profile-avatar-wrapper {
        text-align: center;
        margin-top: -65px;
        position: relative;
        z-index: 2;
    }

    .profile-avatar {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        border: 6px solid var(--card-bg);
        background-color: var(--card-bg);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        object-fit: cover;
    }

    .profile-header {
        text-align: center;
        padding: 15px 20px 25px 20px;
    }

    .profile-header h2 {
        font-size: 1.75rem;
        font-weight: 700;
        margin: 0 0 8px 0;
        color: var(--text-main);
    }

    .role-badge {
        display: inline-block;
        background-color: #f1f5f9;
        color: var(--text-muted);
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        border: 1px solid var(--border-color);
    }

    .divider {
        border: none;
        height: 1px;
        background-color: var(--border-color);
        margin: 0;
    }

    .profile-details {
        padding: 25px 30px 35px 30px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .detail-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background-color: #f8fafc;
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border-color);
        flex-shrink: 0;
    }

    .detail-content {
        display: flex;
        flex-direction: column;
    }

    .detail-label {
        font-size: 0.8rem;
        color: var(--text-muted);
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }

    .detail-value {
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--text-main);
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .status-active { color: var(--success); }
    .status-inactive { color: var(--danger); }

    .status-badge .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .status-active .dot {
        background-color: var(--success);
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    }

    .status-inactive .dot {
        background-color: var(--danger);
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 640px) {
        .profile-details { padding: 20px; }
        .profile-card { border-radius: 16px; }
    }
</style>